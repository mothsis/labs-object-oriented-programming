<Window x:Class="Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentation"
        mc:Ignorable="d"
        Title="Учет рейсов" 
        Height="500" 
        Width="800">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Учет транспортных рейсов" 
                   Grid.Row="0"
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,10"/>

        <!-- Основная область с рейсами -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель - Список рейсов -->
            <Border Grid.Column="0" 
                    BorderBrush="Gray" 
                    BorderThickness="1" 
                    Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Список рейсов" 
                               Grid.Row="0" 
                               FontWeight="Bold" 
                               Background="LightGray" 
                               Padding="5"/>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Рейсы}"
                             DisplayMemberPath="ПредставлениеРейса"
                             Margin="5"
                             SelectionChanged="ListBox_SelectionChanged"/>
                </Grid>
            </Border>

            <!-- Разделитель -->
            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch"/>

            <!-- Правая панель - Детали рейса -->
            <Border Grid.Column="2" 
                    BorderBrush="Gray" 
                    BorderThickness="1" 
                    Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Детали рейса" 
                               Grid.Row="0" 
                               FontWeight="Bold" 
                               Background="LightGray" 
                               Padding="5"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <!-- Транспорт -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Транспорт:" 
                                           Grid.Column="0" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding ВыбранныйРейс.Транспорт, Mode=TwoWay}" 
                                         IsEnabled="{Binding ЕстьВыбранныйРейс}"/>
                            </Grid>

                            <!-- Пункт отправления -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Пункт отправки:" 
                                           Grid.Column="0" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding ВыбранныйРейс.ПунктОтправки, Mode=TwoWay}" 
                                         IsEnabled="{Binding ЕстьВыбранныйРейс}"/>
                            </Grid>

                            <!-- Пункт назначения -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Пункт назначения:" 
                                           Grid.Column="0" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding ВыбранныйРейс.ПунктНазначения, Mode=TwoWay}" 
                                         IsEnabled="{Binding ЕстьВыбранныйРейс}"/>
                            </Grid>

                            <!-- Стоимость -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Стоимость билета:" 
                                           Grid.Column="0" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding ВыбранныйРейс.Стоимость, Mode=TwoWay, StringFormat=F2}" 
                                         IsEnabled="{Binding ЕстьВыбранныйРейс}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижняя панель - Итоги -->
        <Border Grid.Row="2" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Margin="0,10,0,0" 
                Background="LightGray">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая часть - Автобусные рейсы -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Margin="10">
                    <TextBlock Text="Автобусных рейсов:" 
                               FontWeight="Bold" 
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding АвтобусныхРейсов}" 
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Центральная часть - Стоимость самолетов -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Margin="10">
                    <TextBlock Text="Стоимость самолетов:" 
                               FontWeight="Bold" 
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding СтоимостьСамолетов, StringFormat=F2}" 
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Правая часть - Самый дорогой билет -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Margin="10">
                    <TextBlock Text="Самый дорогой билет:" 
                               FontWeight="Bold" 
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding СамыйДорогойБилет, StringFormat=F2}" 
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>